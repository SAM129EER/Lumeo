generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // null = OAuth-only user
  name          String?
  emailVerified DateTime? // null = not verified
  image         String?   // optional profile picture from OAuth

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String // "google", "github", etc.
  providerAccountId String // the unique ID from that provider

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique // always store a HASH of the token
  userId    String
  expiresAt DateTime
  revokedAt DateTime? // null = still valid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String    // the email
  token      String    @unique // always store a HASH of the token
  type       TokenType
  expiresAt  DateTime
  usedAt     DateTime? // null = not used yet

  createdAt  DateTime  @default(now())

  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@index([identifier, type])
  @@map("verification_tokens")
}
